.screen { flex-grow: 1; color: rgb(235, 242, 247); -unity-font-style: bold; }
.header { flex-direction: row; justify-content: space-between; margin: 28px; }
.title-card { padding: 18px 24px; background-color: rgba(12, 23, 37, 0.87); border-left-width: 4px; border-left-color: rgb(57, 219, 214); }
.eyebrow { font-size: 13px; color: rgb(77, 224, 217); letter-spacing: 2px; margin-bottom: 6px; }
.title { font-size: 34px; letter-spacing: 1px; margin-bottom: 8px; }
.objective { font-size: 14px; -unity-font-style: normal; color: rgb(205, 219, 232); margin-bottom: 10px; }
.stats { align-items: flex-end; padding: 16px 20px; background-color: rgba(12, 23, 37, 0.87); }
.speed { font-size: 26px; margin-bottom: 6px; }
.muted { color: rgb(163, 184, 202); font-size: 12px; -unity-font-style: normal; }
.fine { margin-top: 8px; font-size: 10px; letter-spacing: 1px; }
.crosshair { position: absolute; left: 50%; top: 49%; font-size: 18px; color: rgba(235, 242, 247, 0.5); }
.footer { position: absolute; bottom: 24px; left: 28px; padding: 14px 20px; background-color: rgba(12, 23, 37, 0.87); font-size: 12px; }
.pause-screen { position: absolute; left: 0; right: 0; top: 0; bottom: 0; justify-content: center; align-items: center; background-color: rgba(7, 14, 23, 0.76); display: none; }
.pause-card { width: 360px; padding: 30px; background-color: rgb(18, 32, 49); border-top-width: 4px; border-top-color: rgb(57, 219, 214); }
Button { height: 44px; margin-top: 10px; background-color: rgb(38, 62, 81); color: rgb(235, 242, 247); border-width: 0; border-radius: 2px; -unity-font-style: bold; }
Button:hover { background-color: rgb(30, 119, 125); }
Button:focus { border-width: 2px; border-color: rgb(57, 219, 214); }
