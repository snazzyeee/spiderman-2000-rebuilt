config_version=5

[application]
config/name="Spider-Man 2000 Revamp — Godot"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]
GameSession="*res://src/services/game_session.gd"
Dialogue="*res://src/services/dialogue_service.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
lights_and_shadows/directional_shadow/size=2048
environment/defaults/default_clear_color=Color(0.04, 0.06, 0.12, 1)

[physics]
common/physics_ticks_per_second=60

[layer_names]
3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Enemies"
