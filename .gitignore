# Private original/derived assets, raw extraction backups, validation output and logs
/assets/
/staging/

# Private derived level data (generated from original TRG files)
/levels/**/trg_graph.json

# Downloaded portable tools, models and pinned third-party references; retain upstream licenses locally
/tools/third_party/

# Godot caches
**/.godot/
**/.mono/
/tools/pipeline/.cache/

# Python bytecode
__pycache__/
*.py[cod]

# Private reference inventories/conversion logs and generated machine metadata
/docs/research_notes/**/*.json
/docs/research_notes/**/*.log
